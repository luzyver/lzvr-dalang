# min 32 chars (openssl rand -hex 32); grants full control of the gateway (API/MCP, and the fallback sign-in)
LZVR_TOKEN=
# Sign-in: a 6-digit code is mailed through the mailer service (POST <MAILER_URL>/mail/send)
MAILER_URL=https://mailer.example.com
# MAIL_FROM=noreply@example.com
# these emails sign in as the owner (admin); panel users sign in with the email set on their user
LZVR_OWNER_EMAILS=
# local development only: no sign-in, every request is the owner (refused unless HOST is loopback)
# AUTH_BYPASS=true
WORKSPACE_ROOT=/
# Codex accounts are not configured here: an admin adds them in the panel (+ Account).
STATE_DIR=./state
# push + installable app need HTTPS; the origin is also the Web Push contact
# LZVR_ORIGIN=https://panel.example.com
# set to 1 only behind your own reverse proxy
# TRUST_PROXY=1
# MCP_CROSS_SEND=approve
# MCP_INJECT=1
# LIMIT_BLOCK_MINUTES=60
# minutes a restart lets running chats finish before cutting them off (they continue after it); 0 = at once
# DRAIN_MINUTES=5
# Native context compaction window for chat turns (100000..1000000 tokens).
# 0 leaves each CLI's own compaction settings unchanged; it does not disable native compaction.
# CONTEXT_COMPACT_TOKENS=100000
# LIMIT_REGEX=usage limit|rate limit
# the shell the code editor's terminals start (default: PowerShell on Windows, the login shell elsewhere)
# TERMINAL_SHELL=/bin/zsh
# Linux: the code editor's terminals run as this account (not root, no sudo) instead of the service's
# TERMINAL_USER=dalang
